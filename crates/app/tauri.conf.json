{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tsugiki",
  "mainBinaryName": "tsg",
  "identifier": "io.github.tsugiki",
  "build": {
    "beforeDevCommand": { "script": "npm run dev -w ui", "cwd": "../.." },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build -w ui", "cwd": "../.." },
    "frontendDist": "../../ui/build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Tsugiki", "width": 1280, "height": 800, "create": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["tsugiki"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
