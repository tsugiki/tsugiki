{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gh-rev-app-shell-prototype",
  "version": "0.1.0",
  "identifier": "dev.ghrev.prototype.appshell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "gh-rev \u2014 app shell PROTOTYPE",
        "width": 1500,
        "height": 950
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
