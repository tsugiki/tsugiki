{
  "name": "tsugiki",
  "private": true,
  "description": "A review workbench for GitHub",
  "license": "MIT",
  "type": "module",
  "workspaces": ["ui"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "bindings": "node scripts/bindings.ts",
    "check": "npm run svelte-check && npm run clippy",
    "doc-width": "node scripts/doc-width.ts",
    "prose-check": "node scripts/prose-check.ts",
    "lint": "npm run eslint && npm run prettier && npm run rustfmt && npm run token-deps && npm run pre-commit",
    "fmt": "npm run fmt -w ui && prettier --write scripts .github eslint.config.ts codecov.yml && cargo fmt --all",
    "test": "npm run vitest && npm run cargo-test && npm run stale-bindings",
    "e2e": "npm run e2e -w ui --",
    "bench": "cargo bench -p tsugiki-core && npm run bench -w ui",
    "record": "cargo run -p tsugiki-core --example record",
    "tauri": "tauri",
    "eslint": "npm run eslint -w ui && eslint scripts eslint.config.ts",
    "prettier": "npm run prettier -w ui && prettier --check scripts .github eslint.config.ts codecov.yml",
    "rustfmt": "cargo fmt --all --check",
    "token-deps": "node scripts/token-deps.ts",
    "pre-commit": "pre-commit run --all-files",
    "svelte-check": "npm run check -w ui",
    "clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "vitest": "npm run coverage -w ui --",
    "fetch-ty": "node scripts/fetch-ty.ts",
    "cargo-test": "node scripts/fetch-ty.ts cargo test --workspace -- --skip bindings_are_up_to_date",
    "stale-bindings": "cargo test -p tsugiki-app --test bindings",
    "highlight-samples": "cargo test -p tsugiki-core --lib highlight::tests::each_sample",
    "rust-coverage": "node scripts/fetch-ty.ts node scripts/rust-coverage.ts",
    "smoke": "node scripts/smoke.ts",
    "release-check": "node scripts/release-check.ts",
    "deny": "cargo deny --locked check",
    "machete": "cargo machete"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6"
  }
}
